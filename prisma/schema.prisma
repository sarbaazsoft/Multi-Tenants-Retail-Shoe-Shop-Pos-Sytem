generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PricingPolicy {
  FIXED
  NEGOTIABLE
}

enum TenantStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum SubscriptionPlan {
  SIX_MONTHS @map("6_MONTHS")
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum UserRole {
  SUPERADMIN
  ADMIN
  CASHIER
}

model Tenant {
  id                    Int                @id @default(autoincrement())
  name                  String
  slug                  String             @unique
  status                TenantStatus       @default(ACTIVE)
  appKey                String             @unique @map("app_key")
  subscriptionPlan      SubscriptionPlan   @default(YEARLY) @map("subscription_plan")
  subscriptionStartDate DateTime           @default(now()) @map("subscription_start_date")
  subscriptionEndDate   DateTime           @map("subscription_end_date")
  subscriptionStatus    SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  themeColor            String             @default("#2563EB") @map("theme_color")
  backgroundColor       String             @default("#ffffff") @map("background_color")
  logoUrl               String             @default("") @map("logo_url")
  ownerName             String             @default("") @map("owner_name")
  ownerEmail            String             @default("") @map("owner_email")
  ownerPhone            String             @default("") @map("owner_phone")
  businessAddress       String             @default("") @map("business_address")
  taxId                 String             @default("") @map("tax_id")
  currency              String             @default("PKR")
  currencySymbol        String             @default("Rs.") @map("currency_symbol")
  plan                  String             @default("PRO")
  isOnboarded           Boolean            @default(false) @map("is_onboarded")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at")

  @@index([slug], map: "tenants_slug_idx")
  @@index([status], map: "tenants_status_idx")
  @@index([appKey], map: "tenants_app_key_idx")
  @@index([subscriptionStatus], map: "tenants_subscription_status_idx")
  @@map("tenants")
}

model StoreRequest {
  id                  Int      @id @default(autoincrement())
  storeName           String   @map("store_name")
  requestedSlug       String   @map("requested_slug")
  ownerName           String   @map("owner_name")
  ownerEmail          String   @map("owner_email")
  ownerPhone          String   @default("") @map("owner_phone")
  businessAddress     String   @default("") @map("business_address")
  plan                String   @default("PRO")
  notes               String   @default("")
  status              String   @default("PENDING")
  provisionedTenantId Int?     @map("provisioned_tenant_id")
  initialPassword     String   @default("") @map("initial_password")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("store_requests")
}

model StoreSettings {
  id                  Int           @id @default(autoincrement())
  tenantId            Int           @default(1) @map("tenant_id")
  name                String        @default("Your Shoe Store")
  logo                String        @default("")
  address             String        @default("")
  phone               String        @default("")
  email               String        @default("")
  website             String        @default("")
  strn                String        @default("")
  taxId               String        @default("") @map("tax_id")
  taxNumber           String        @default("") @map("tax_number")
  currency            String        @default("PKR")
  currencyName        String        @default("Pakistani Rupee") @map("currency_name")
  currencySymbol      String        @default("Rs.") @map("currency_symbol")
  invoicePrefix       String        @default("INV-") @map("invoice_prefix")
  purchasePrefix      String        @default("PUR-") @map("purchase_prefix")
  barcodePrefix       String        @default("0108923") @map("barcode_prefix")
  invoiceFooter       String        @default("Thank you for shopping with us!") @map("invoice_footer")
  lowStockLimit       Int           @default(5) @map("low_stock_limit")
  pricingPolicy       PricingPolicy @default(FIXED) @map("pricing_mode")
  pricingPolicyLocked Boolean       @default(false) @map("pricing_policy_locked")
  isInstalled         Boolean       @default(false) @map("is_installed")
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at")

  @@index([tenantId], map: "company_settings_tenant_idx")
  @@map("company_settings")
}

model Product {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @default(1) @map("tenant_id")
  brand           String   @default("Local")
  category        String   @default("Casual Shoes")
  sku             String
  article         String
  barcode         String
  description     String   @default("")
  primaryImageUrl String   @default("") @map("primary_image_url")
  costPrice       Decimal  @db.Decimal(12, 2) @map("cost_price")
  sellingPrice    Int      @map("selling_price")
  minPrice        Int      @map("min_price")
  maxPrice        Int      @map("max_price")
  totalStock      Int      @default(0) @map("total_stock")
  lowStockLimit   Int      @default(5) @map("low_stock_limit")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([tenantId], map: "products_tenant_idx")
  @@index([barcode], map: "products_barcode_idx")
  @@index([sku], map: "products_sku_idx")
  @@index([article], map: "products_article_idx")
  @@index([active], map: "products_active_idx")
  @@index([brand], map: "products_brand_idx")
  @@index([category], map: "products_category_idx")
  @@map("products")
}
